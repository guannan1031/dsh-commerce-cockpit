{
  "name": "@guannan1031/dsh-commerce-cockpit",
  "version": "0.1.2",
  "private": false,
  "description": "Runnable DeepSeek Harness ecommerce cockpit demo with explicit Demo/Imported data modes, CSV validation, metric overview and rule-based Q&A.",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "README.md",
    "cordis.patch.yml",
    "LICENSE",
    "templates"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/guannan1031/dsh-commerce-cockpit.git"
  },
  "bugs": {
    "url": "https://github.com/guannan1031/dsh-commerce-cockpit/issues"
  },
  "homepage": "https://github.com/guannan1031/dsh-commerce-cockpit",
  "scripts": {
    "test": "node --test tests/index.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6"
  }
}
